     return 2;
 }
 
+/*
+ * SimGDB test patch: QEMU_ARM_M_BIGEND=1 emulates an M-profile core with
+ * AIRCR.ENDIANNESS = 1 (BE8 data). The gdbstub then sends registers in that
+ * byte order, as a hardware debug probe on such a core would.
+ */
+static inline bool simgdb_arm_m_bigend(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        v = getenv("QEMU_ARM_M_BIGEND") != NULL;
+    }
+    return v;
+}
+
 static inline int gdb_get_reg32(GByteArray *buf, uint32_t val)
 {
-    if (target_big_endian()) {
+    if (target_big_endian() || simgdb_arm_m_bigend()) {
         cpu_to_be32s(&val);
     } else {
         cpu_to_le32s(&val);
@@ -56,7 +70,7 @@ static inline int gdb_get_reg32(GByteArray *buf, uint32_t val)
 
